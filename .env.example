APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Seeded admin account (AdminUserSeeder). ADMIN_PASSWORD is required outside
# local development; the password is only written when the account is created.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google sign-in (Laravel Socialite). Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AI_IMAGE_PROVIDER=fake
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_QUALITY=medium
AI_IMAGE_SIZE=1024x1536
AI_IMAGE_FAKE_FAILURE=false
OPENAI_API_KEY=
# Uploaded-photo moderation: 'openai' rejects unsafe photos and photos with no
# person/pet subject; 'fake' allows everything (local/dev).
ARTWORK_MODERATION_PROVIDER=fake
AI_BACKGROUND_REMOVAL_PYTHON=python
ARTWORK_MAX_GENERATIONS=3
ARTWORK_RETENTION_DAYS=30
CART_EXPIRY_DAYS=30
CART_MAX_QUANTITY=10
PAYMENT_PROVIDER=fake
FAKE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_TAX_STRATEGY=zero_uk
PRODIGI_ENV=sandbox
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com
PRODIGI_API_KEY=
PRODIGI_TIMEOUT=30
TREATPOD_APP_ID=
TREATPOD_SECRET_KEY=
ADDRESS_LOOKUP_PROVIDER=postcodes_io
POSTCODES_IO_BASE_URL=https://api.postcodes.io
POSTCODES_IO_TIMEOUT=5
POSTCODES_IO_CONNECT_TIMEOUT=3
# Property-level provider (returns real address dropdown options). Free tier: 100 calls/month,
# no card. Sign up at https://homedata.co.uk/register, then set ADDRESS_LOOKUP_PROVIDER=homedata.
HOMEDATA_BASE_URL=https://api.homedata.co.uk
HOMEDATA_API_KEY=
HOMEDATA_TIMEOUT=5
HOMEDATA_CONNECT_TIMEOUT=3
# Alternative property-level provider. Needs a billing-enabled Google Cloud project
# with Places API (New) enabled, then set ADDRESS_LOOKUP_PROVIDER=google_places.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT=10
GOOGLE_PLACES_CONNECT_TIMEOUT=6
