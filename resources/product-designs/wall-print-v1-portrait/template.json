    "max_width": 1.0,
    "max_height": 1.0,
    "adjustment_limits": {
      "scale_min": 0.2,
      "scale_max": 5,
      "offset_x_min": -0.5,
      "offset_x_max": 0.5,
      "offset_y_min": -0.5,
      "offset_y_max": 0.5
    }
  },
  "layers": [
    { "id": "artwork", "type": "generation_asset", "config": "character", "fit": "cover" }
  ]
